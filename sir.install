<?php

/**
 * Implements hook_schema().
 */
function sir_schema() {
  $schema['sir_anatomy_mapping'] = [
    'description' => 'Coordinate-to-UBERON mappings for SIR Search by Anatomy.',
    'fields' => [
      'id' => [
        'description' => 'Primary key.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'label' => [
        'description' => 'Display label for the mapped anatomy.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ],
      'uberon_uri' => [
        'description' => 'Mapped UBERON URI.',
        'type' => 'varchar',
        'length' => 512,
        'not null' => TRUE,
      ],
      'x_min' => [
        'description' => 'Minimum normalized X coordinate (0-100).',
        'type' => 'float',
        'not null' => TRUE,
        'default' => 0,
      ],
      'x_max' => [
        'description' => 'Maximum normalized X coordinate (0-100).',
        'type' => 'float',
        'not null' => TRUE,
        'default' => 0,
      ],
      'y_min' => [
        'description' => 'Minimum normalized Y coordinate (0-100).',
        'type' => 'float',
        'not null' => TRUE,
        'default' => 0,
      ],
      'y_max' => [
        'description' => 'Maximum normalized Y coordinate (0-100).',
        'type' => 'float',
        'not null' => TRUE,
        'default' => 0,
      ],
      'description' => [
        'description' => 'Optional free-text description.',
        'type' => 'varchar',
        'length' => 1024,
        'not null' => TRUE,
        'default' => '',
      ],
      'status' => [
        'description' => '1 for enabled mappings, 0 for disabled.',
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 1,
      ],
      'weight' => [
        'description' => 'Sort weight for deterministic ordering.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
      'created' => [
        'description' => 'Unix timestamp when record was created.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'changed' => [
        'description' => 'Unix timestamp when record was updated.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'uid' => [
        'description' => 'User id that created the record.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'status_weight' => ['status', 'weight'],
      'uberon_uri' => ['uberon_uri'],
    ],
  ];

  return $schema;
}

/**
 * Creates anatomy mapping table for existing installs.
 */
function sir_update_8002() {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('sir_anatomy_mapping')) {
    $definition = sir_schema();
    $schema->createTable('sir_anatomy_mapping', $definition['sir_anatomy_mapping']);
  }
}

