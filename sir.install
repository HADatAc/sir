/**
 * Expands lung mapping into a selectable chest region.
 */
function sir_update_8007() {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('sir_anatomy_mapping')) {
    return;
  }

  $db = \Drupal::database();
  $now = \Drupal::time()->getRequestTime();

  // Ensure lung is selectable as an area rather than a single point.
  // This region intentionally overlaps heart; the UI overlap chooser handles it.
  $fields = [
    'uberon_uri' => 'http://purl.obolibrary.org/obo/UBERON_0002048',
    'x_min' => 39.0,
    'x_max' => 61.0,
    'y_min' => 17.0,
    'y_max' => 34.0,
    'description' => 'Normalized selectable lung chest region',
    'status' => 1,
    'weight' => 45,
    'changed' => $now,
  ];

  $updated = $db->update('sir_anatomy_mapping')
    ->fields($fields)
    ->condition('label', ['lung', 'Lung'], 'IN')
    ->execute();

  if (!$updated) {
    $db->insert('sir_anatomy_mapping')
      ->fields($fields + [
        'label' => 'lung',
        'created' => $now,
        'uid' => 1,
      ])
      ->execute();
  }
}
