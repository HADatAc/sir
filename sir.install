        'x_max' => $mapping['x_max'],
        'y_min' => $mapping['y_min'],
        'y_max' => $mapping['y_max'],
        'description' => 'Seeded default full-body mapping',
        'status' => 1,
        'weight' => $mapping['weight'],
        'created' => $now,
        'changed' => $now,
        'uid' => 1,
      ])
      ->execute();
  }
}

/**
 * Adds additional default mappings and normalizes malformed legacy URIs.
 */
function sir_update_8004() {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('sir_anatomy_mapping')) {
    return;
  }

  $now = \Drupal::time()->getRequestTime();
  $db = \Drupal::database();

  // Normalize legacy malformed UBERON URI for Lung rows.
  $db->update('sir_anatomy_mapping')
    ->fields([
      'uberon_uri' => 'http://purl.obolibrary.org/obo/UBERON_0002048',
      'changed' => $now,
    ])
    ->condition('label', 'Lung')
    ->condition('uberon_uri', 'http://purl.obolibrary.org/obo/UBERON_/0002048')
    ->execute();

  // Coordinates are normalized percentages over full_body.png (0-100).
  $mappings = [
    [
      'label' => 'sholder',
