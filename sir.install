/**
 * Removes selected default mappings that should no longer be available.
 */
function sir_update_8005() {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('sir_anatomy_mapping')) {
    return;
  }

  $labels_to_remove = [
    'hand',
    'right hand',
    'left hand',
    'ledt hand',
    'foot',
    'right foot',
    'left foot',
    'knee',
    'right knee',
    'left knee',
    'shoulder',
    'right shoulder',
    'left shoulder',
    'sholder',
    'leg',
    'right leg',
    'left leg',
  ];

  \Drupal::database()->delete('sir_anatomy_mapping')
    ->condition('label', $labels_to_remove, 'IN')
    ->execute();
}

